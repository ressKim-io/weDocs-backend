<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  weDocs 프로젝트 Checkstyle 규칙.
  Phase 1: 네이밍 컨벤션 + Javadoc 문서화 규칙만 적용.
  Requirement 2.3: boolean 메서드 is/has/can/should 접두사.
  Requirement 6.1: public 클래스 Javadoc 필수.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">

        <!-- Req 6.1: public 클래스에 클래스 레벨 Javadoc 필수 -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="severity" value="warning"/>
        </module>

        <!--
          Req 2.3: boolean 반환 메서드는 is/has/can/should 접두사 사용.
          Checkstyle MethodName 모듈은 반환 타입 기반 필터링을 지원하지 않으므로,
          일반 메서드명 camelCase 규칙을 적용한다. boolean 접두사 검증은 코드 리뷰에서 보완.
        -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- 인라인 억제 주석 지원: // CHECKSTYLE:OFF MethodName ~ // CHECKSTYLE:ON MethodName -->
        <module name="SuppressionCommentFilter">
            <property name="offCommentFormat" value="CHECKSTYLE:OFF MethodName"/>
            <property name="onCommentFormat" value="CHECKSTYLE:ON MethodName"/>
        </module>

    </module>

    <!-- Repository 인터페이스: Spring Data JPA 파생 쿼리 메서드명(underscore 허용) -->
    <module name="SuppressionSingleFilter">
        <property name="files" value=".*Repository\.java$"/>
        <property name="checks" value="MethodName"/>
    </module>

    <!-- 테스트 코드: underscore 구분 테스트 메서드명 허용 (BDD 스타일) -->
    <module name="SuppressionSingleFilter">
        <property name="files" value=".*[/\\]test[/\\].*\.java$"/>
        <property name="checks" value="MethodName"/>
    </module>

</module>
